# MySQL 8 database for LDMS v2 (a new database, separate from the old PHP system)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/ldms_v2"
# Session encryption key: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Email (phase 4). The daily job and LDMS send through this mailbox. Never put the password in code.
SMTP_HOST=""            # e.g. smtp.office365.com
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""            # the sender: an address, or Name <address>; defaults to SMTP_USER
# The address people reach LDMS at, for links in emails (no trailing slash, without /phn-ldms)
APP_URL="http://localhost:3006"
# Whether anything is really sent is L&D's Sending switch on the Jobs and email screen; it starts off.
