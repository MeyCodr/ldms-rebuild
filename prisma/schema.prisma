// LDMS v2 schema.
// Phase 1: org chart, staff, roles, audit log and settings.
// Phase 2: trainings, sessions and participants.
// PME, TNA, TNI and skill-matrix models are added in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StaffStatus {
  ACTIVE
  RESIGNED
}

enum Designation {
  NON_EXECUTIVE
  EXECUTIVE
  MANAGER
  CONTRACT
  TRAINEE
}

// Roles granted explicitly. HOD and division head are not roles: they come
// from Department.hodId and Division.headId, so they can never disagree
// with the org chart.
enum RoleCode {
  LD_ADMIN
  MAIN_CLERK
  CLERK
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  IMPORT
}

model Division {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(120)
  shortName   String?      @db.VarChar(20)
  headId      Int?
  legacyId    Int?         @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  head        Staff?       @relation("DivisionHead", fields: [headId], references: [id], onDelete: SetNull)
  departments Department[]
}

model Department {
  id         Int        @id @default(autoincrement())
  divisionId Int
  name       String     @db.VarChar(120)
  shortName  String?    @db.VarChar(20)
  hodId      Int? // replaces the trigger that rewrote user.hodid
  legacyId   Int?       @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  division   Division   @relation(fields: [divisionId], references: [id])
  hod        Staff?     @relation("DepartmentHod", fields: [hodId], references: [id], onDelete: SetNull)
  sections   Section[]
  staff      Staff[]    @relation("DepartmentStaff")
  trainings  Training[]

  @@unique([divisionId, name])
  @@index([hodId])
}

model Section {
  id           Int        @id @default(autoincrement())
  departmentId Int
  name         String     @db.VarChar(120)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id])
  staff        Staff[]

  @@unique([departmentId, name])
}

model Staff {
  id                 Int           @id @default(autoincrement())
  staffNo            String        @unique @db.VarChar(20) // the old table allowed duplicates
  name               String        @db.VarChar(160)
  email              String?       @db.VarChar(160)
  position           String?       @db.VarChar(120)
  designation        Designation
  status             StaffStatus   @default(ACTIVE)
  dateJoined         DateTime?     @db.Date
  dateResigned       DateTime?     @db.Date
  departmentId       Int
  sectionId          Int?
  passwordHash       String?       @db.VarChar(255) // argon2id
  legacyMd5          String?       @db.Char(32) // cleared after the first sign-in
  mustChangePassword Boolean       @default(false)
  sessionVersion     Int           @default(0) // bumped on password reset/change; older sessions stop working
  lastSignInAt       DateTime?
  legacyId           Int?          @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  department         Department    @relation("DepartmentStaff", fields: [departmentId], references: [id])
  section            Section?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  roles              StaffRole[]
  hodOf              Department[]  @relation("DepartmentHod")
  headOf             Division[]    @relation("DivisionHead")
  auditEntries       AuditLog[]
  participants       Participant[]
  trainerOf          Training[]    @relation("TrainingTrainer")

  @@index([departmentId, status])
  @@index([designation, status])
  @@index([name])
}

model StaffRole {
  staffId   Int
  role      RoleCode
  grantedAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([staffId, role])
}

model AuditLog {
  id        BigInt      @id @default(autoincrement())
  actorId   Int?
  action    AuditAction
  entity    String      @db.VarChar(40)
  entityId  String?     @db.VarChar(40)
  summary   String      @db.VarChar(255)
  changes   Json? // { field: [before, after] }
  createdAt DateTime    @default(now())
  actor     Staff?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Setting {
  key         String   @id @db.VarChar(80)
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById Int?
}

// ---------- Phase 2: training ----------

enum TrainingType {
  PUBLIC_INHOUSE // a course for staff, run by an external provider or at PHN
  OJT // on-the-job training
  DEPARTMENTAL // run by a department for its own staff
}

// The next three lists match the old system's Add Training form.
enum TrainingProgram {
  EXTERNAL_PUBLIC // external public program
  INTERNAL_EXTERNAL_TRAINER // internal training by an external trainer
  INTERNAL_INTERNAL_TRAINER // internal training by an internal trainer
}

enum TrainingFunction {
  BUSINESS
  DIGITAL
  LEADERSHIP
  PERSONAL_EFFECTIVENESS
}

enum TrainingPlatform {
  PHYSICAL
  ONLINE
}

enum TrainingStatus {
  SCHEDULED
  CANCELLED
}

enum Attendance {
  PENDING
  COMPLETED
  ABSENT
}

enum ParticipantSource {
  ADMIN // added by L&D
  CLERK // OJT entered or imported by a clerk
  SELF // OJT recorded by the staff member
  IMPORT // Excel import
}

model Training {
  id             Int               @id @default(autoincrement())
  type           TrainingType
  title          String            @db.VarChar(200)
  code           String?           @db.VarChar(40)
  provider       String?           @db.VarChar(160) // training provider / organiser
  trainerName    String?           @db.VarChar(160) // free text, or a copy of the internal trainer's name
  trainerStaffId Int? // set only for "internal training by internal trainer"
  venue          String?           @db.VarChar(160)
  program        TrainingProgram? // required on the form except for OJT
  function       TrainingFunction?
  platform       TrainingPlatform?
  category       String?           @db.VarChar(80)
  hrdfClaimable  Boolean           @default(false) // "HRDC" on screen (HRD Corp, formerly HRDF)
  cost           Decimal?          @db.Decimal(12, 2) // RM, whole course
  description    String?           @db.Text
  startDate      DateTime          @db.Date
  endDate        DateTime          @db.Date
  startTime      DateTime          @db.Time(0)
  endTime        DateTime          @db.Time(0)
  status         TrainingStatus    @default(SCHEDULED)
  departmentId   Int? // organising department (DEPARTMENTAL, and OJT)
  createdById    Int?
  legacySource   String?           @db.VarChar(10) // "training" | "ojt": old IDs overlap between tables
  legacyId       Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  department     Department?       @relation(fields: [departmentId], references: [id])
  trainerStaff   Staff?            @relation("TrainingTrainer", fields: [trainerStaffId], references: [id], onDelete: SetNull)
  sessions       TrainingSession[]
  participants   Participant[]

  @@unique([legacySource, legacyId])
  @@index([type, startDate]) // replaces the old *_archive tables
  @@index([startDate])
}

// Optional. Only for trainings whose days are not consecutive or whose times
// differ per day. Without sessions, hours come from the date range × daily hours.
model TrainingSession {
  id         Int      @id @default(autoincrement())
  trainingId Int
  date       DateTime @db.Date
  startTime  DateTime @db.Time(0)
  endTime    DateTime @db.Time(0)
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, date, startTime])
}

model Participant {
  id              Int               @id @default(autoincrement())
  trainingId      Int
  staffId         Int
  attendance      Attendance        @default(PENDING)
  source          ParticipantSource @default(ADMIN)
  recordedById    Int? // who added the row (clerk, admin or the staff member)
  absentReason    String?           @db.VarChar(255)
  feedback        Json? // answers, shape checked by the Zod schema for feedbackVersion
  feedbackVersion Int?
  submittedAt     DateTime?
  certificateFile String?           @db.VarChar(255) // stored name under uploads/certificates
  certificateName String?           @db.VarChar(255) // original file name, for download
  certificateAt   DateTime?
  legacyId        Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  training        Training          @relation(fields: [trainingId], references: [id])
  staff           Staff             @relation(fields: [staffId], references: [id])
  // phase 3: pme Pme?

  @@unique([trainingId, staffId])
  @@index([staffId, attendance])
  @@index([attendance, trainingId])
}
